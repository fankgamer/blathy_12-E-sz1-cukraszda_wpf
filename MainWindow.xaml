<Window x:Class="cukraszda_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Olasz Cukrászda"
        Height="420" Width="500"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Fájl">
                <MenuItem Header="Adatfájl betöltése" Click="Betoltes_Click"/>
            </MenuItem>

            <MenuItem x:Name="sutemenyekMenu"
                      Header="Sütemények"
                      Click="Sutemenyek_Click"/>

            <MenuItem Header="Névjegy" Click="Nevjegy_Click"/>
        </Menu>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="ÁRLISTA"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="DarkOrange"
                       HorizontalAlignment="Center"
                       Margin="10"/>

            <Image x:Name="kep"
                   Width="350"
                   Height="240"
                   Stretch="UniformToFill"/>

            <TextBlock x:Name="statusText"
                       Text="Először töltsd be az adatfájlt!"
                       HorizontalAlignment="Center"
                       Margin="10"
                       FontSize="14"/>
        </StackPanel>

    </DockPanel>
</Window>